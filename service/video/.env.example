# Supabase project credentials (same project as service/db)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>

# Optional overrides
# TTS_VOICE=bn-IN-Chirp3-HD-Achernar
# FFMPEG_BIN=/path/to/ffmpeg   # local dev: pip install imageio-ffmpeg and point this
#                               # at imageio_ffmpeg.get_ffmpeg_exe() if ffmpeg isn't on PATH

# GCP credentials: use Application Default Credentials locally
# (`gcloud auth application-default login`) -- Cloud TTS and GCS clients both
# read them automatically, no key file needed here.
